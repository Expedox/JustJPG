{
  "manifest_version": 3,
  "name": "JustJPG",
  "short_name": "JustJPG",
  "version": "1.0.0",
  "description": "Speichert jedes Bild mit einem Klick als JPG. WEBP, AVIF, HEIC, PNG, SVG, Videos und Canvas werden lokal konvertiert.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "JustJPG: Alle Bilder dieser Seite",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "permissions": [
    "contextMenus",
    "downloads",
    "storage",
    "scripting",
    "offscreen",
    "activeTab",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["lib/defaults.js", "content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "commands": {
    "save-under-cursor": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Bild unter dem Mauszeiger als JPG speichern"
    },
    "save-visible": {
      "description": "Sichtbaren Bereich der Seite als JPG speichern"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
